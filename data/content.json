  "journalPage": {
    "hero": {
      "eyebrow": "Journal",
      "title": "Notes from the studio table",
      "intro": "Process stories, care guidance, gift ideas, material notes, and inspiration from the Meraki Arts 53 creative practice."
    },
    "featuredLabel": "Featured note",
    "readLabel": "Read story",
    "articles": [
      {
        "slug": "behind-the-studio-table",
        "category": "Behind the scenes",
        "title": "Behind the studio table",
        "excerpt": "A look at how references, color, material, and occasion come together before a handmade piece begins.",
        "readTime": "3 min read",
        "image": "/images/customized-gifts/customized-gift-detail-01.webp",
        "sections": [
          {
            "heading": "Start with the moment",
            "body": "The strongest pieces begin with the person and the occasion. A few references, colors, and practical details help the studio choose the right direction."
          },
          {
            "heading": "Then shape the material",
            "body": "Each medium behaves differently. Texture work needs depth, embroidery needs balance, and decor work needs structure, finish, and presentation."
          }
        ]
      },
      {
        "slug": "care-for-handmade-pieces",
        "category": "Care notes",
        "title": "How to care for handmade pieces",
        "excerpt": "Simple care habits for storing, gifting, and displaying handcrafted decor, textile detail, and keepsakes.",
        "readTime": "4 min read",
        "image": "/images/lamasa/lamasa-decor-05.webp",
        "sections": [
          {
            "heading": "Keep it dry and supported",
            "body": "Store delicate pieces away from moisture and pressure. Use a flat surface or protective box for decor and keepsakes."
          },
          {
            "heading": "Handle details gently",
            "body": "Small decorative elements can be strong but still need careful handling, especially during gifting, packing, or event setup."
          }
        ]
      },
      {
        "slug": "gift-ideas-with-a-personal-touch",
        "category": "Gift ideas",
        "title": "Gift ideas with a personal touch",
        "excerpt": "Ways to turn a small handmade detail into a thoughtful gift for birthdays, weddings, milestones, and intimate celebrations.",
        "readTime": "3 min read",
        "image": "/images/customized-gifts/customized-gift-detail-08.webp",
        "sections": [
          {
            "heading": "Use the recipient as the brief",
            "body": "Favorite colors, initials, dates, memories, and hobbies can become the anchor for a custom gift."
          },
          {
            "heading": "Make presentation part of the piece",
            "body": "A handmade gift feels more complete when the finishing, note, packaging, and reveal all feel intentional."
          }
        ]
      },
      {
        "slug": "material-notes-lamasa-terrazzo-and-thread",
        "category": "Material notes",
        "title": "Material notes: lamasa, terrazzo, and thread",
        "excerpt": "A short guide to choosing a medium based on texture, durability, color, and the kind of detail the final piece needs.",
        "readTime": "5 min read",
        "image": "/images/terrazzo/terrazzo-decor-01.webp",
        "sections": [
          {
            "heading": "Texture changes the feeling",
            "body": "Soft thread, sculptural lamasa, painted surfaces, and terrazzo-inspired details each carry a different mood."
          },
          {
            "heading": "Choose by purpose",
            "body": "A display piece, wearable detail, event accent, and keepsake each need a different balance of delicacy and structure."
          }
        ]
      }
    ]
